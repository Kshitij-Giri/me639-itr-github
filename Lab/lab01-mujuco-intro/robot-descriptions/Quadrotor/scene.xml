<?xml version="1.0" encoding="UTF-8"?>

<mujoco model="quadrotor_scene">

    <!-- Load the actual quadrotor model -->

    <include file="quadrotor.xml"/>


    <visual>

        <headlight
            diffuse="0.8 0.8 0.8"
            ambient="0.3 0.3 0.3"
            specular="0.1 0.1 0.1"
        />

        <global
            azimuth="120"
            elevation="-20"
        />

    </visual>


    <asset>

        <!-- Sky -->

        <texture
            name="sky"
            type="skybox"
            builtin="gradient"
            rgb1="0.3 0.5 0.7"
            rgb2="0.05 0.05 0.05"
            width="512"
            height="3072"
        />


        <!-- Ground -->

        <texture
            name="ground"
            type="2d"
            builtin="checker"
            rgb1="0.25 0.3 0.35"
            rgb2="0.12 0.15 0.18"
            width="300"
            height="300"
        />


        <material
            name="ground_mat"
            texture="ground"
            texuniform="true"
            texrepeat="5 5"
            reflectance="0.2"
        />

    </asset>


    <worldbody>

        <!-- Light -->

        <light
            name="main_light"
            pos="0 0 3"
            dir="0 0 -1"
            directional="true"
        />


        <!-- Ground -->

        <geom
            name="floor"
            type="plane"
            size="5 5 0.1"
            material="ground_mat"
        />

    </worldbody>

</mujoco>