<?xml version="1.0" encoding="UTF-8"?>
<!--
  Open-top dark-grey destination container for the HEAL pick-and-place scene.
  Outer footprint: 0.12 x 0.12 m.
  Wall thickness: 0.006 m; base thickness: 0.006 m; wall height: 0.05 m.
  The free joint allows the main simulation to reposition the container.
  Intended to be composed into the main scene, not loaded alone.
-->
<mujoco model="pick_place_container">
  <worldbody>
    <body name="container" pos="0.48 0.12 0.25">
      <freejoint name="container_free"/>
      <!-- Base: top of the base is at local z = +0.006 m. -->
      <geom name="container_base" type="box"
        size="0.06 0.06 0.006" pos="0 0 0"
        rgba="0.12 0.12 0.13 1"
        mass="0.20" contype="1" conaffinity="1"
        friction="1.0 0.005 0.0001"/>
      <!-- Walls surround the base and leave the top open. -->
      <geom name="container_wall_x_pos" type="box"
        size="0.06 0.006 0.025" pos="0 0.054 0.031"
        rgba="0.12 0.12 0.13 1"/>
      <geom name="container_wall_x_neg" type="box"
        size="0.06 0.006 0.025" pos="0 -0.054 0.031"
        rgba="0.12 0.12 0.13 1"/>
      <geom name="container_wall_y_pos" type="box"
        size="0.006 0.048 0.025" pos="0.054 0 0.031"
        rgba="0.12 0.12 0.13 1"/>
      <geom name="container_wall_y_neg" type="box"
        size="0.006 0.048 0.025" pos="-0.054 0 0.031"
        rgba="0.12 0.12 0.13 1"/>
      <site name="container_drop_site" pos="0 0 0.012" size="0.004"
        rgba="0.2 1 0.2 0"/>
    </body>
  </worldbody>
</mujoco>
